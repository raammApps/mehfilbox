# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Addressing ───────────────────────────────────────────────────────────────
# The domain everything hangs off. Changing it is configuration, never a code change.
# `lvh.me` and `*.lvh.me` are public DNS pointing at 127.0.0.1, so subdomain mode works
# locally with no /etc/hosts edit: http://aanya-vikram.lvh.me:3000
ROOT_DOMAIN=lvh.me:3000

# subdomain  <slug>.example.com + admin.example.com. What doc 02 §1 specifies; needs wildcard
#            DNS, which on Vercel means delegating the domain's nameservers.
# path       example.com/c/<slug> + example.com/admin. One ordinary CNAME, no nameserver change.
TENANCY_MODE=subdomain

# Shown to a couple whose subscription has lapsed.
SUPPORT_EMAIL=hello@example.com

# ─── Data layer ───────────────────────────────────────────────────────────────
# memory   in-process, seeded from the demo fixture. Tests and `pnpm dev` with no Supabase.
# file     memory + JSON persistence under .data/. Useful for a laptop demo.
# supabase Postgres with RLS. Required in production.
DATA_DRIVER=file

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Video provider ───────────────────────────────────────────────────────────
# fake  deterministic local provider — no network, used by tests, CI and the offline demo
# bunny Bunny Stream
VIDEO_DRIVER=fake

BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=
BUNNY_WEBHOOK_SECRET=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# 32+ chars. Signs operator sessions and passcode cookies. Generate: openssl rand -hex 32
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef

# Seeded operator for local development only; ignored when DATA_DRIVER=supabase.
DEV_OPERATOR_EMAIL=operator@mehfilbox.test
DEV_OPERATOR_PASSWORD=mehfilbox-dev
