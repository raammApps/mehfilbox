# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Addressing ───────────────────────────────────────────────────────────────
# The domain everything hangs off. Changing it is configuration, never a code change.
# `lvh.me` and `*.lvh.me` are public DNS pointing at 127.0.0.1, so subdomain mode works
# locally with no /etc/hosts edit: http://aanya-vikram.lvh.me:3000
ROOT_DOMAIN=lvh.me:3000

# path       example.com/<studio>/<wedding> + example.com/admin. The product (D-32): one domain,
#            one certificate, no wildcard. `/c/<wedding>` redirects to the canonical address.
# subdomain  <wedding>.example.com + admin.example.com. Retired; kept for the Playwright harness.
#            Needs wildcard DNS, which on Vercel means delegating the domain's nameservers.
TENANCY_MODE=path

# Shown to a couple whose subscription has lapsed.
SUPPORT_EMAIL=hello@example.com

# ─── Data layer ───────────────────────────────────────────────────────────────
# memory   in-process, seeded from the demo fixture. Tests and `pnpm dev` with no Supabase.
# file     memory + JSON persistence under .data/. Useful for a laptop demo.
# supabase Postgres with RLS. Required in production.
DATA_DRIVER=file

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Video provider ───────────────────────────────────────────────────────────
# fake  deterministic local provider — no network, used by tests, CI and the offline demo
# bunny Bunny Stream
VIDEO_DRIVER=fake

BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=
BUNNY_WEBHOOK_SECRET=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# 32+ chars. Signs operator sessions and passcode cookies. Generate: openssl rand -hex 32
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef

# Seeded operator for local development only; ignored when DATA_DRIVER=supabase.
DEV_OPERATOR_EMAIL=operator@mehfilbox.test
DEV_OPERATOR_PASSWORD=mehfilbox-dev

# The challenge after repeated sign-in and guest-code failures, and on every registration (D-34).
# none      rate limits and lockouts only, no widget (the default)
# fake      a checkbox that yields a fixed token — what the test suite runs
# turnstile Cloudflare Turnstile; needs both keys below
CAPTCHA_DRIVER=none
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Custom domains (doc 16 §1). DNS is always checked for real; this is what happens after.
# none    a verified domain waits until you add it to the hosting project and mark it attached
# fake    the suite's: a .test host is verified and attached at once
# vercel  attached through the API; needs the token and project id below
DOMAIN_DRIVER=none
DOMAIN_CNAME_TARGET=cname.mehfilbox.com
DOMAIN_A_RECORD=76.76.21.21
DOMAIN_NAMESERVERS=ns1.vercel-dns.com,ns2.vercel-dns.com
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
